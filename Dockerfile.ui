FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --pre . && useradd --uid 10001 --create-home app \
    && mkdir /app/.data && chown app:app /app/.data
USER 10001
EXPOSE 8501
CMD ["streamlit", "run", "src/regulatory_poc/ui/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
